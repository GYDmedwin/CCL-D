@@ -13,14 +13,31 @@
 #include "common.h"
 #include "ccld.h"
 
-// One writer per protocol subgroup; tree split executes two groups concurrently.
+// Mode 1: one writer per protocol subgroup. Mode 2: all participating
+// threads use GPU atomics; initialization requires native host atomics.
 __device__ __forceinline__ void ccldCount(CcldBlock* b, int tid, int group, bool send, bool recv) {
-  if (b != nullptr && tid == 0 && ncclShmem.channelId < CCLD_MAX_CHANNELS) {
-    int g = group == 0 ? 0 : 1;
+  if (b == nullptr || ncclShmem.channelId >= CCLD_MAX_CHANNELS) return;
+  int g = group == 0 ? 0 : 1;
+  if (b->mode == 1 && tid == 0) {
     volatile uint64_t* s = &b->channel[ncclShmem.channelId].send[g];
     volatile uint64_t* r = &b->channel[ncclShmem.channelId].recv[g];
     if (send) *s = *s + 1;
     if (recv) *r = *r + 1;
+  } else if (b->mode == 2) {
+    if (send) atomicAdd((unsigned long long*)&b->channel[ncclShmem.channelId].send[g], 1ull);
+    if (recv) atomicAdd((unsigned long long*)&b->channel[ncclShmem.channelId].recv[g], 1ull);
+  }
+}
+
+// Explicitly opt-in simulation: bounded in GPU clock cycles and abort-aware.
+// H3 spins once per primitive subgroup; S2 delays each send operation.
+__device__ __forceinline__ void ccldInject(CcldBlock* b, int tid, bool& hangDone) {
+  if (b == nullptr || tid != 0 || b->faultKind == 0 || b->faultCycles == 0) return;
+  if (b->faultKind == 1 && hangDone) return;
+  if (b->faultKind == 1) hangDone = true;
+  unsigned long long started = clock64();
+  while (clock64() - started < b->faultCycles) {
+    if (*ncclShmem.comm.abortFlag) break;
   }
 }
 
