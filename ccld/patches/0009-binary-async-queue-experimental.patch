diff --git a/src/include/ccld_log.h b/src/include/ccld_log.h
new file mode 100644
index 0000000..21245c3
--- /dev/null
+++ b/src/include/ccld_log.h
@@ -0,0 +1,29 @@
+#ifndef NCCL_CCLD_LOG_H_
+#define NCCL_CCLD_LOG_H_
+
+#include <stdint.h>
+#include <type_traits>
+#include "ccld.h"
+
+// Version 1 records are fixed-size, little-endian on the target x86_64 host.
+// All fields are values, never pointers. The decoder rejects other versions,
+// truncated records and unknown event types.
+enum CcldLogType : uint32_t {
+  CcldLogInit = 1, CcldLogEntered = 2, CcldLogSnapshot = 3,
+  CcldLogComplete = 4, CcldLogHeartbeat = 5, CcldLogDropped = 6
+};
+struct CcldLogChannel {
+  int32_t id, parent;
+  uint64_t send, recv, sendChanges, recvChanges, sendDelta, recvDelta;
+};
+struct CcldLogEvent {
+  uint32_t magic, version, type, reserved;
+  uint64_t hash, seq, nowNs, startNs, count, bytes, windowNs;
+  uint32_t rank, nranks, frameBytes, frameChannels, frameGroups, pollUs, mode, nChannels;
+  char host[64], op[16], algorithm[16], protocol[16], datatype[16], reason[64];
+  CcldLogChannel channels[CCLD_MAX_CHANNELS];
+};
+static_assert(sizeof(CcldLogChannel) == 56, "binary channel layout changed");
+static_assert(sizeof(CcldLogEvent) == 2088, "binary event layout changed");
+static_assert(std::is_trivially_copyable<CcldLogEvent>::value, "binary records must be trivially copyable");
+#endif
diff --git a/src/include/ccld_queue.h b/src/include/ccld_queue.h
new file mode 100644
index 0000000..51024be
--- /dev/null
+++ b/src/include/ccld_queue.h
@@ -0,0 +1,55 @@
+#ifndef NCCL_CCLD_QUEUE_H_
+#define NCCL_CCLD_QUEUE_H_
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// Bounded multi-producer/single-consumer queue. A full queue never waits for
+// the writer; callers must explicitly record a dropped event instead.
+template <typename T, size_t Capacity>
+class CcldQueue {
+  static_assert(Capacity >= 2, "queue needs at least two cells");
+  struct Cell {
+    std::atomic<size_t> sequence;
+    T value;
+  };
+  Cell cells[Capacity];
+  std::atomic<size_t> producer{0};
+  size_t consumer = 0;
+
+ public:
+  CcldQueue() {
+    for (size_t i = 0; i < Capacity; ++i) cells[i].sequence.store(i, std::memory_order_relaxed);
+  }
+  bool lockFree() const { return producer.is_lock_free(); }
+  bool push(const T& value) {
+    size_t pos = producer.load(std::memory_order_relaxed);
+    Cell* cell;
+    for (;;) {
+      cell = &cells[pos % Capacity];
+      const size_t sequence = cell->sequence.load(std::memory_order_acquire);
+      const intptr_t diff = intptr_t(sequence) - intptr_t(pos);
+      if (diff == 0) {
+        if (producer.compare_exchange_weak(pos, pos + 1, std::memory_order_relaxed)) break;
+      } else if (diff < 0) {
+        return false;
+      } else {
+        pos = producer.load(std::memory_order_relaxed);
+      }
+    }
+    cell->value = value;
+    cell->sequence.store(pos + 1, std::memory_order_release);
+    return true;
+  }
+  bool pop(T& value) {
+    Cell& cell = cells[consumer % Capacity];
+    const size_t sequence = cell.sequence.load(std::memory_order_acquire);
+    if (intptr_t(sequence) - intptr_t(consumer + 1) != 0) return false;
+    value = cell.value;
+    cell.sequence.store(consumer + Capacity, std::memory_order_release);
+    ++consumer;
+    return true;
+  }
+};
+#endif
