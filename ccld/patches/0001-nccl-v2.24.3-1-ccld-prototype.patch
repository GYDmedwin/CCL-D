diff --git a/src/misc/ccld.cc b/src/misc/ccld.cc
new file mode 100644
index 0000000..0d5ccfb
--- /dev/null
+++ b/src/misc/ccld.cc
@@ -0,0 +1,310 @@
+#include "ccld.h"
+#include "comm.h"
+#include "info.h"
+#include "collectives.h"
+#include "debug.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <inttypes.h>
+#include <map>
+#include <mutex>
+#include <thread>
+#include <time.h>
+#include <unistd.h>
+
+static uint64_t ccldNow() {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return uint64_t(t.tv_sec) * 1000000000ull + t.tv_nsec;
+}
+
+struct CcldStart {
+  uint64_t ns, count, bytes;
+  const char* op;
+  const char* dtype;
+};
+struct CcldSlot {
+  bool active = false;
+  std::atomic<bool> done{false};
+  std::atomic<uint64_t> endNs{0};
+  uint64_t seq = 0, startNs = 0, lastDumpNs = 0;
+  uint64_t count = 0, bytes = 0;
+  const char* op = nullptr;
+  const char* dtype = nullptr;
+  const char* algo = nullptr;
+  const char* proto = nullptr;
+  int lo = 0, hi = -1;
+  int parents[CCLD_MAX_CHANNELS] = {};
+  uint64_t lastSend[CCLD_MAX_CHANNELS] = {}, lastRecv[CCLD_MAX_CHANNELS] = {};
+  uint64_t dumpSend[CCLD_MAX_CHANNELS] = {}, dumpRecv[CCLD_MAX_CHANNELS] = {};
+  uint64_t changesSend[CCLD_MAX_CHANNELS] = {}, changesRecv[CCLD_MAX_CHANNELS] = {};
+};
+struct CcldState {
+  std::mutex mu;
+  std::condition_variable cv;
+  bool stop = false;
+  FILE* out = nullptr;
+  CcldFrame* frame = nullptr;
+  CcldFrame* device = nullptr;
+  std::thread thread;
+  CcldSlot slots[CCLD_BLOCKS];
+  std::map<uint64_t, CcldStart> pending;
+  uint64_t hash = 0, counter = 0, pollUs = 200, dumpNs = 1000000000ull;
+  int rank = 0, nranks = 0;
+};
+struct CcldCallback { CcldState* state; int slot; };
+
+static uint64_t envNumber(const char* key, uint64_t fallback, uint64_t lo, uint64_t hi) {
+  const char* s = getenv(key);
+  if (!s || !*s) return fallback;
+  char* end = nullptr;
+  unsigned long long v = strtoull(s, &end, 10);
+  return end != s && *end == 0 && v >= lo && v <= hi ? v : fallback;
+}
+static void ccldPrefix(CcldState* s, const char* type, uint64_t seq, uint64_t now) {
+  fprintf(s->out, "{\"event\":\"%s\",\"comm_hash\":\"%016" PRIx64 "\",\"rank\":%d,\"world_size\":%d,\"mono_ns\":%" PRIu64 ",\"op_count\":%" PRIu64,
+          type, s->hash, s->rank, s->nranks, now, seq);
+}
+static void ccldStatus(CcldState* s, const char* type, uint64_t seq, const char* reason) {
+  ccldPrefix(s, type, seq, ccldNow());
+  fprintf(s->out, ",\"reason\":\"%s\"}\n", reason);
+  fflush(s->out);
+}
+static uint64_t ccldLoad(const uint64_t* p) {
+  return *(const volatile uint64_t*)p;
+}
+static void ccldSample(CcldState* s, int idx) {
+  CcldSlot& slot = s->slots[idx];
+  const CcldBlock& b = s->frame->blocks[idx];
+  for (int c = slot.lo; c <= slot.hi; ++c) {
+    uint64_t send = 0, recv = 0;
+    for (int g = 0; g < CCLD_GROUPS; ++g) {
+      send += ccldLoad(&b.channel[c].send[g]);
+      recv += ccldLoad(&b.channel[c].recv[g]);
+    }
+    if (send != slot.lastSend[c]) ++slot.changesSend[c];
+    if (recv != slot.lastRecv[c]) ++slot.changesRecv[c];
+    slot.lastSend[c] = send;
+    slot.lastRecv[c] = recv;
+  }
+}
+static void ccldEmit(CcldState* s, int idx, const char* type, uint64_t now) {
+  CcldSlot& slot = s->slots[idx];
+  const uint64_t elapsed = now >= slot.startNs ? now - slot.startNs : 0;
+  const uint64_t window = now > slot.lastDumpNs ? now - slot.lastDumpNs : 1;
+  ccldPrefix(s, type, slot.seq, now);
+  fprintf(s->out, ",\"start_mono_ns\":%" PRIu64 ",\"duration_ns\":%" PRIu64
+          ",\"op\":\"%s\",\"algorithm\":\"%s\",\"protocol\":\"%s\",\"datatype\":\"%s\",\"count\":%" PRIu64
+          ",\"bytes\":%" PRIu64 ",\"n_channels\":%d,\"channels\":[",
+          slot.startNs, elapsed, slot.op, slot.algo, slot.proto, slot.dtype, slot.count,
+          slot.bytes, slot.hi-slot.lo+1);
+  for (int c = slot.lo; c <= slot.hi; ++c) {
+    if (c != slot.lo) fputc(',', s->out);
+    fprintf(s->out, "{\"id\":%d,\"tree_parent\":%d,\"send_count\":%" PRIu64 ",\"recv_count\":%" PRIu64 ",\"send_rate\":",
+            c, slot.parents[c], slot.lastSend[c], slot.lastRecv[c]);
+    if (slot.changesSend[c]) fprintf(s->out, "%.12g", 1.0 / slot.changesSend[c]);
+    else fputs("null", s->out);
+    fputs(",\"recv_rate\":", s->out);
+    if (slot.changesRecv[c]) fprintf(s->out, "%.12g", 1.0 / slot.changesRecv[c]);
+    else fputs("null", s->out);
+    fprintf(s->out, ",\"send_delta_per_ms\":%.12g,\"recv_delta_per_ms\":%.12g}",
+            double(slot.lastSend[c] - slot.dumpSend[c])*1e6/window,
+            double(slot.lastRecv[c] - slot.dumpRecv[c])*1e6/window);
+    slot.dumpSend[c] = slot.lastSend[c];
+    slot.dumpRecv[c] = slot.lastRecv[c];
+    slot.changesSend[c] = slot.changesRecv[c] = 0;
+  }
+  fputs("]", s->out);
+  if (strcmp(type, "complete") == 0) {
+    double busbw = elapsed ? double(slot.bytes)*2.0*(s->nranks-1)/s->nranks / double(elapsed) : 0.0;
+    fprintf(s->out, ",\"busbw_gbps\":%.12g", busbw);
+  }
+  fputs("}\n", s->out);
+  fflush(s->out);
+  slot.lastDumpNs = now;
+}
+static void ccldWorker(CcldState* s) {
+  std::unique_lock<std::mutex> lock(s->mu);
+  uint64_t lastHeartbeat = ccldNow();
+  while (!s->stop) {
+    s->cv.wait_for(lock, std::chrono::microseconds(s->pollUs));
+    uint64_t now = ccldNow();
+    for (int i = 0; i < CCLD_BLOCKS; ++i) {
+      CcldSlot& slot = s->slots[i];
+      if (!slot.active) continue;
+      ccldSample(s, i);
+      if (slot.done.load(std::memory_order_acquire)) {
+        uint64_t end = slot.endNs.load(std::memory_order_relaxed);
+        ccldEmit(s, i, "complete", end);
+        slot.active = false;
+      } else if (now - slot.lastDumpNs >= s->dumpNs) {
+        ccldEmit(s, i, "snapshot", now);
+      }
+    }
+    if (now - lastHeartbeat >= s->dumpNs) {
+      ccldPrefix(s, "heartbeat", s->counter, now);
+      fputs("}\n", s->out);
+      fflush(s->out);
+      lastHeartbeat = now;
+    }
+  }
+  // Drain already completed slots even if shutdown follows a callback quickly.
+  for (int i = 0; i < CCLD_BLOCKS; ++i) {
+    CcldSlot& slot = s->slots[i];
+    if (!slot.active) continue;
+    ccldSample(s, i);
+    if (slot.done.load(std::memory_order_acquire)) {
+      ccldEmit(s, i, "complete", slot.endNs.load(std::memory_order_relaxed));
+      slot.active = false;
+    } else {
+      ccldEmit(s, i, "snapshot", ccldNow());
+    }
+  }
+}
+void ccldInit(ncclComm* comm) {
+  static_assert(MAXCHANNELS <= CCLD_MAX_CHANNELS, "increase CCLD_MAX_CHANNELS");
+  if (envNumber("NCCL_CCLD_ENABLE", 0, 0, 1) != 1) return;
+  uint64_t mode = envNumber("NCCL_CCLD_MODE", 1, 0, 2);
+  if (mode == 0) return;
+  if (mode != 1) {
+    WARN("CCL-D prototype supports mode 1 only; telemetry disabled");
+    return;
+  }
+  const char* dir = getenv("NCCL_CCLD_OUT_DIR");
+  if (!dir || !*dir) {
+    WARN("CCL-D requires an existing NCCL_CCLD_OUT_DIR; telemetry disabled");
+    return;
+  }
+  CcldState* s = new CcldState();
+  s->rank = comm->rank; s->nranks = comm->nRanks; s->hash = comm->commHash;
+  s->pollUs = envNumber("NCCL_CCLD_POLL_US", 200, 20, 1000000);
+  s->dumpNs = envNumber("NCCL_CCLD_DUMP_MS", 1000, 10, 60000) * 1000000ull;
+  char path[4096];
+  int n = snprintf(path, sizeof(path), "%s/ccld-%016" PRIx64 "-rank%d-pid%ld.jsonl", dir, s->hash, s->rank, (long)getpid());
+  if (n < 0 || size_t(n) >= sizeof(path) || (s->out = fopen(path, "w")) == nullptr) {
+    WARN("CCL-D cannot open output; telemetry disabled"); delete s; return;
+  }
+  cudaError_t err = cudaHostAlloc((void**)&s->frame, sizeof(CcldFrame), cudaHostAllocMapped);
+  if (err == cudaSuccess) err = cudaHostGetDevicePointer((void**)&s->device, s->frame, 0);
+  if (err != cudaSuccess) {
+    WARN("CCL-D mapped allocation failed: %s", cudaGetErrorString(err));
+    if (s->frame) cudaFreeHost(s->frame);
+    fclose(s->out); delete s; return;
+  }
+  memset(s->frame, 0, sizeof(CcldFrame)); s->frame->mode = 1;
+  ccldPrefix(s, "comm_init", 0, ccldNow());
+  fprintf(s->out, ",\"frame_bytes\":%zu,\"poll_us\":%" PRIu64 "}\n", sizeof(CcldFrame), s->pollUs);
+  fflush(s->out);
+  comm->ccldState = s;
+  s->thread = std::thread(ccldWorker, s);
+}
+uint64_t ccldEnter(ncclComm* comm, const ncclInfo* info) {
+  CcldState* s = static_cast<CcldState*>(comm->ccldState);
+  std::lock_guard<std::mutex> lock(s->mu);
+  uint64_t seq = ++s->counter;
+  uint64_t now = ccldNow();
+  CcldStart start{now, info->count, info->count * uint64_t(ncclTypeSize(info->datatype)),
+                  ncclFuncToString(info->coll), ncclDatatypeToString(info->datatype)};
+  s->pending[seq] = start;
+  ccldPrefix(s, "entered", seq, now);
+  fprintf(s->out, ",\"op\":\"%s\",\"count\":%" PRIu64 ",\"bytes\":%" PRIu64 ",\"datatype\":\"%s\"}\n",
+          start.op, start.count, start.bytes, start.dtype);
+  fflush(s->out);
+  return seq;
+}
+void ccldPlan(ncclComm* comm, ncclKernelPlan* plan) {
+  CcldState* s = static_cast<CcldState*>(comm->ccldState);
+  std::lock_guard<std::mutex> lock(s->mu);
+  ncclTaskColl* task = ncclIntruQueueHead(&plan->collTaskQueue);
+  if (!task) return;
+  const bool supported = !plan->persistent && !task->next && ncclIntruQueueEmpty(&plan->p2pTaskQueue) &&
+      task->func == ncclFuncAllReduce && (task->algorithm == NCCL_ALGO_RING || task->algorithm == NCCL_ALGO_TREE);
+  if (!supported) {
+    for (ncclTaskColl* t = task; t; t = t->next) {
+      ccldStatus(s, "dropped", t->ccldSeq, "unsupported_group_graph_or_operation");
+      s->pending.erase(t->ccldSeq);
+    }
+    return;
+  }
+  auto it = s->pending.find(task->ccldSeq);
+  if (it == s->pending.end()) return;
+  const int index = int(task->ccldSeq % CCLD_BLOCKS);
+  CcldSlot& slot = s->slots[index];
+  if (slot.active) {
+    ccldStatus(s, "dropped", task->ccldSeq, "frame_slot_busy");
+    s->pending.erase(it); return;
+  }
+  ncclWorkList* node = ncclIntruQueueHead(&plan->workQueue);
+  if (!node || (node->workType != ncclDevWorkTypeColl && node->workType != ncclDevWorkTypeCollReg)) {
+    ccldStatus(s, "dropped", task->ccldSeq, "unexpected_work_type");
+    s->pending.erase(it); return;
+  }
+  ncclDevWorkColl* work = reinterpret_cast<ncclDevWorkColl*>(node + 1);
+  memset(&s->frame->blocks[index], 0, sizeof(CcldBlock));
+  s->frame->blocks[index].commHash = s->hash;
+  s->frame->blocks[index].opCount = task->ccldSeq;
+  s->frame->kernelIndex = index; s->frame->counter = task->ccldSeq;
+  s->frame->detectChannel = work->channelHi - work->channelLo + 1;
+  slot.seq = task->ccldSeq; slot.startNs = it->second.ns; slot.lastDumpNs = slot.startNs;
+  slot.count = it->second.count; slot.bytes = it->second.bytes;
+  slot.op = it->second.op; slot.dtype = it->second.dtype;
+  slot.algo = ncclAlgoToString(task->algorithm); slot.proto = ncclProtoToString(task->protocol);
+  slot.lo = work->channelLo; slot.hi = work->channelHi;
+  for (int c = 0; c < CCLD_MAX_CHANNELS; ++c) {
+    slot.parents[c] = comm->channels[c].tree.up;
+    slot.lastSend[c] = slot.lastRecv[c] = slot.dumpSend[c] = slot.dumpRecv[c] = 0;
+    slot.changesSend[c] = slot.changesRecv[c] = 0;
+  }
+  slot.done.store(false, std::memory_order_relaxed); slot.endNs.store(0, std::memory_order_relaxed);
+  slot.active = true;
+  work->ccldBlock = &s->device->blocks[index];
+  plan->ccldSlotPlus1 = index + 1;
+  s->pending.erase(it);
+  s->cv.notify_one();
+}
+static void CUDART_CB ccldDone(void* data) {
+  CcldCallback* cb = static_cast<CcldCallback*>(data);
+  CcldSlot& slot = cb->state->slots[cb->slot];
+  slot.endNs.store(ccldNow(), std::memory_order_relaxed);
+  slot.done.store(true, std::memory_order_release);
+  cb->state->cv.notify_one();
+  delete cb;
+}
+void ccldCallbackEnqueue(ncclComm* comm, ncclKernelPlan* plan, cudaStream_t stream) {
+  CcldState* s = static_cast<CcldState*>(comm->ccldState);
+  CcldCallback* cb = new CcldCallback{s, plan->ccldSlotPlus1-1};
+  cudaError_t err = cudaLaunchHostFunc(stream, ccldDone, cb);
+  if (err != cudaSuccess) {
+    delete cb;
+    std::lock_guard<std::mutex> lock(s->mu);
+    ccldStatus(s, "dropped", s->slots[plan->ccldSlotPlus1-1].seq, "host_callback_failed");
+    WARN("CCL-D callback enqueue failed: %s", cudaGetErrorString(err));
+    // Do not reuse the slot: the kernel may still be writing to it.
+  }
+}
+void ccldFree(ncclComm* comm) {
+  CcldState* s = static_cast<CcldState*>(comm->ccldState);
+  if (!s) return;
+  {
+    std::lock_guard<std::mutex> lock(s->mu);
+    s->stop = true; s->cv.notify_one();
+  }
+  s->thread.join();
+  bool active = false;
+  for (int i = 0; i < CCLD_BLOCKS; ++i) active |= s->slots[i].active && !s->slots[i].done.load(std::memory_order_acquire);
+  fclose(s->out);
+  comm->ccldState = nullptr;
+  if (active) {
+    // An aborted/erroring CUDA stream may suppress callbacks. Keep storage alive
+    // until process exit rather than risking a device or callback use-after-free.
+    WARN("CCL-D retains pinned storage after incomplete/aborted kernel");
+    return;
+  }
+  cudaFreeHost(s->frame);
+  delete s;
+}
